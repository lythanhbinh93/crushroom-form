<!-- Bao gồm thư viện Croppie -->
<div class="container-layout">
  <form method="post" action="" name="contact-form">
    <div class="header">
      <h3 class="title-heading">Tải ảnh CouplePix</h3>
      <div class="description"><p>Ảnh này được dùng cho viên ngọc (ảnh chiếu sáng).</p></div>
    </div>
    <div class="form-builder">
      <div class="form-control">
        <label for="33109-phone-1" class="classic-label globo-label ">
          <span class="label-content" data-label="Số điện thoại đặt hàng">Số điện thoại đặt hàng</span>
          <span class="text-danger text-smaller"> *</span>
        </label>
        <div class="form-group">
          <div class="form-phone">
            <div class="globo-form-icon">
              <svg
                aria-hidden="true"
                focusable="false"
                data-prefix="fas"
                data-icon="phone-alt"
                class="svg-inline--fa fa-phone-alt fa-w-16"
                role="img"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 512 512"
              >
                <path fill="currentColor" d="M497.39 361.8l-112-48a24 24 0 0 0-28 6.9l-49.6 60.6A370.66 370.66 0 0 1 130.6 204.11l60.6-49.6a23.94 23.94 0 0 0 6.9-28l-48-112A24.16 24.16 0 0 0 122.6.61l-104 24A24 24 0 0 0 0 48c0 256.5 207.9 464 464 464a24 24 0 0 0 23.4-18.6l24-104a24.29 24.29 0 0 0-14.01-27.6z"></path>
              </svg>
            </div>
            <input type="text" id="mobile_code" placeholder="91 234 56 78" name="Name">
           <!-- <br/> <input type="text" id="test" placeholder="91 234 56 78" name="Test"> -->
          </div>
        </div>
        <small class="help-text globo-description">Vui lòng điền số điện thoại đặt hàng để shop làm đúng ảnh</small>
        <small class="messages" id="phone-error" style="display: none;"></small>
      </div>

      <div class="form-control">
        <label class="classic-label globo-label ">
          <span class="label-content" data-label="Bạn muốn làm ảnh giống hay khác nhau?">
            Bạn muốn làm ảnh giống hay khác nhau?
          </span>
          <span class="text-danger text-smaller"> *</span>
        </label>
        <div class="globo-form-input">
          <ul class="flex-wrap">
            <li class="globo-list-control option-1-column">
              <div class="radio-wrapper">
                <input
                  class="radio-input"
                  id="one-image"
                  type="radio"
                  checked="true"
                  data-type="radio"
                  name="radio"
                  presence=""
                  value="one-image"
                  data-gtm-form-interact-field-id="1"
                >
                <label class="radio-label globo-option" for="one-image">Chỉ dùng một ảnh</label>
              </div>
            </li>

            <li class="globo-list-control option-1-column">
              <div class="radio-wrapper">
                <input
                  class="radio-input"
                  id="many-image"
                  type="radio"
                  data-type="radio"
                  name="radio"
                  presence=""
                  value="many-image"
                  data-gtm-form-interact-field-id="2"
                >
                <label class="radio-label globo-option" for="many-image">Mỗi sản phẩm 1 ảnh</label>
              </div>
            </li>
          </ul>
        </div>
        <small class="help-text globo-description">
          Nếu bạn đặt từ 3 sản phẩm trở lên (mỗi sản phẩm 1 ảnh) thì gửi nhiều lần!
        </small>
        <small class="messages"></small>
      </div>

      <div class="form-control choose-file">
        <label for="temp-for-choose-file-1" class="classic-label globo-label ">
          <span class="label-content" data-label="Ảnh cần làm">Ảnh cần làm</span>
          <span class="text-danger text-smaller"> *</span>
        </label>
        <div class="globo-form-input">
          <div class="dropzone">
            <div class="dropzone--content">
              <div class="dropzone--placeholder">
                <div class="dropzone--placeholder--title">Chọn ảnh hoặc kéo ảnh vào đây</div>

                <div class="dropzone--placeholder--description">Định dạng hỗ trợ: JPG, JPEG, PNG, HEIC, HEIF.</div>
                <label for="choose-file-1" class="dropzone--placeholder--button">Chọn ảnh</label>
                <!-- <button type="button" for="choose-file-1" class="dropzone--placeholder--button">Chọn ảnh</button> -->
              </div>
              <div class="dropzone--preview--area">
                <div class="img-preview" id="img-preview-1"></div>
                <button class="couplepix-close t4s-drawer__close" type="button" data-file-remove="choose-file-1" data-file-index="1">
                  <svg class="t4s-iconsvg-close" role="presentation" viewBox="0 0 16 14"><path d="M15 0L1 14m14 0L1 0" stroke="currentColor" fill="none" fill-rule="evenodd"></path></svg>
                </button>
              </div>
            </div>
            <input style="display: none;" type="file" id="choose-file-1" name="image-1" accept="image/*">
            <input type="hidden" name="ImgData1" id="ImgData1" >
          </div>
        </div>
        <small class="messages" id="file-error"></small>
      </div>
      <!-- <div class="form-control show-block">
        <label class="classic-label globo-label ">
          <span class="label-content" data-label="Ảnh 1 làm cho sản phẩm nào?">Ảnh 1 làm cho sản phẩm nào?</span>
          <span class="text-danger text-smaller"> *</span>
        </label>
        <div class="globo-form-input">
          <textarea
            data-type="textarea"
            class="classic-input textarea-1"
            rows="3"
            placeholder=""
            name="note-image-1"
          ></textarea>
        </div>
        <small class="messages" id="textarea-1"></small>
      </div> -->
      <div class="form-control show-block">
        <label for="temp-for-choose-file-2" class="classic-label globo-label "
          ><span class="label-content" data-label="Ảnh cần làm (Ảnh 2)">Ảnh cần làm (Ảnh 2)</span
          ><span class="text-danger text-smaller"> *</span></label
        >
        <div class="globo-form-input">
          <div class="dropzone">
            <div class="dropzone--content">
              <div class="dropzone--placeholder">
                <div class="dropzone--placeholder--title">Chọn ảnh hoặc kéo ảnh vào đây</div>

                <div class="dropzone--placeholder--description">Định dạng hỗ trợ: JPG, JPEG, PNG, HEIC, HEIF.</div>
                <label for="choose-file-2" class="dropzone--placeholder--button">Chọn ảnh</label>
                <!-- <button type="button" for="choose-file-2" class="dropzone--placeholder--button">Chọn ảnh</button> -->
              </div>
              <div class="dropzone--preview--area">
                <div class="img-preview" id="img-preview-2"></div>
                <button class="couplepix-close t4s-drawer__close" type="button" data-file-remove="choose-file-2" data-file-index="2">
                  <svg class="t4s-iconsvg-close" role="presentation" viewBox="0 0 16 14"><path d="M15 0L1 14m14 0L1 0" stroke="currentColor" fill="none" fill-rule="evenodd"></path></svg>
                </button>
              </div>
            </div>
            <input style="display:none" type="file" id="choose-file-2" name="image-2" accept="image/*">
            <input type="hidden" name="ImgData2" id="ImgData2" >
          </div>
        </div>
        <small class="messages"></small>
      </div>
      <!-- <div class="form-control show-block">
        <label class="classic-label globo-label ">
          <span class="label-content" data-label="Ảnh 2 làm cho sản phẩm nào?">Ảnh 2 làm cho sản phẩm nào?</span>
          <span class="text-danger text-smaller"> *</span>
        </label>
        <div class="globo-form-input">
          <textarea
            data-type="textarea"
            class="classic-input textarea-2"
            rows="3"
            placeholder=""
            name="note-image-2"
          ></textarea>
        </div>
        <small class="messages" id="textarea-2"></small>
      </div> -->
      <div class="form-control">
        <label class="classic-label globo-label "
          ><span class="label-content" data-label="Ghi chú">Ghi chú (Dành cho đơn từ 2 ảnh). Mô tả ảnh nào dùng cho sản phẩm nào.<br>Ví dụ: Vòng nam: ảnh nắm tay, vòng nữ: ảnh hôn nhau</br> </span><span></span
        ></label>
        <div class="globo-form-input">
          <textarea
            data-type="textarea"
            class="classic-input textarea"
            rows="3"
            placeholder=""
            name="message"
          ></textarea>
        </div>
        <small class="messages"></small>
      </div>

      <div class="form-control">
        <div class="gfb__footer wizard__footer">
          <div class="description globo-description"></div>
          <button type="submit" class="globo-form-app"><span id="loaderBtn" style="display: none;" class="spinner"></span>
          <span id="submitBtn">Gửi ảnh</span>
          </button>
          <p class="wizard__congrats-message"></p>
        </div>
      </div>
    </div>
  </form>
  <div class="message success"></div>
</div>

<script src="{{ 'couple-pix.js' | asset_url }}"></script>
