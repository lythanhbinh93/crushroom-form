{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/((?!counter|voice|voice-upload|love-counter-upload|gift-upload|qr-404|assets/|favicon).*)",
      "has": [{ "type": "host", "value": "qr.crushroom.vn" }],
      "destination": "/qr-404",
      "permanent": false
    },
    {
      "source": "/(love-counter-upload|voice-upload|gift-upload|counter|voice)",
      "has": [{ "type": "host", "value": "admin.crushroom.vn" }],
      "destination": "https://qr.crushroom.vn/$1",
      "permanent": false
    },
    {
      "source": "/(love-counter-upload|voice-upload|gift-upload|counter|voice)",
      "has": [{ "type": "host", "value": "crushroom-form.vercel.app" }],
      "destination": "https://qr.crushroom.vn/$1",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "crushroom-form.vercel.app" }],
      "destination": "https://admin.crushroom.vn/$1",
      "permanent": false
    }
  ]
}
